{
  "uid": "ns-detections",
  "title": "NetStream / Detections",
  "description": "Срабатывания онлайн-детектора (ml/ml-online-detector, M16): is_attack, score, задержка обнаружения из netstream.detections.v1.",
  "tags": [
    "netstream",
    "detections"
  ],
  "schemaVersion": 41,
  "version": 1,
  "editable": false,
  "graphTooltip": 1,
  "timezone": "browser",
  "time": {
    "from": "now-3h",
    "to": "now"
  },
  "refresh": "30s",
  "templating": {
    "list": [
      {
        "name": "host",
        "label": "Sensor",
        "type": "query",
        "datasource": {
          "type": "grafana-clickhouse-datasource",
          "uid": "netstream-clickhouse"
        },
        "query": "SELECT DISTINCT host_id FROM detections WHERE $__timeFilter(window_start) ORDER BY host_id",
        "refresh": 2,
        "multi": true,
        "includeAll": true,
        "current": {
          "selected": true,
          "text": [
            "All"
          ],
          "value": [
            "$__all"
          ]
        }
      }
    ]
  },
  "annotations": {
    "list": []
  },
  "panels": [
    {
      "id": 1,
      "type": "stat",
      "title": "Attacks flagged",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "netstream-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "netstream-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() FROM detections WHERE $__timeFilter(window_start) AND is_attack AND host_id IN (${host:singlequote})",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "red"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 2,
      "type": "stat",
      "title": "Windows scored",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "netstream-clickhouse"
      },
      "gridPos": {
        "x": 6,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "netstream-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT count() FROM detections WHERE $__timeFilter(window_start) AND host_id IN (${host:singlequote})",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "color": {
            "mode": "fixed",
            "fixedColor": "blue"
          },
          "unit": "short"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 3,
      "type": "stat",
      "title": "Detection latency p50 (ms)",
      "description": "Медиана latency_ms: время между теоретическим концом окна и моментом оценки. Может быть основана на малой выборке в коротком окне времени.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "netstream-clickhouse"
      },
      "gridPos": {
        "x": 12,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "netstream-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT median(latency_ms) FROM detections WHERE $__timeFilter(window_start) AND host_id IN (${host:singlequote})",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 4,
      "type": "stat",
      "title": "Detection latency p95 (ms)",
      "description": "Может быть отрицательной для окон, закрытых принудительным flush() до их теоретического конца — см. README ml-online-detector.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "netstream-clickhouse"
      },
      "gridPos": {
        "x": 18,
        "y": 0,
        "w": 6,
        "h": 4
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "netstream-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT quantile(0.95)(latency_ms) FROM detections WHERE $__timeFilter(window_start) AND host_id IN (${host:singlequote})",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "ms"
        },
        "overrides": []
      },
      "options": {
        "reduceOptions": {
          "calcs": [
            "lastNotNull"
          ],
          "fields": "",
          "values": false
        },
        "colorMode": "value",
        "graphMode": "none",
        "textMode": "value"
      }
    },
    {
      "id": 5,
      "type": "timeseries",
      "title": "Detections over time by sensor",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "netstream-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 24,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "netstream-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(window_start) AS time, host_id, countIf(is_attack) AS attacks FROM detections WHERE $__timeFilter(window_start) AND host_id IN (${host:singlequote}) GROUP BY time, host_id ORDER BY time",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 60,
            "showPoints": "never"
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
    {
      "id": 6,
      "type": "table",
      "title": "Latest detections",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "netstream-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
        "w": 24,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "netstream-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT window_start, host_id, src_ip, window_seconds, score, toUInt8(is_attack) AS is_attack, latency_ms FROM detections WHERE $__timeFilter(window_start) AND host_id IN (${host:singlequote}) ORDER BY window_start DESC LIMIT 200",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": [
          {
            "matcher": {
              "id": "byName",
              "options": "is_attack"
            },
            "properties": [
              {
                "id": "custom.cellOptions",
                "value": {
                  "type": "color-background"
                }
              },
              {
                "id": "color",
                "value": {
                  "mode": "thresholds"
                }
              },
              {
                "id": "thresholds",
                "value": {
                  "mode": "absolute",
                  "steps": [
                    {
                      "color": "green",
                      "value": null
                    },
                    {
                      "color": "red",
                      "value": 1
                    }
                  ]
                }
              }
            ]
          }
        ]
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm",
        "sortBy": [
          {
            "displayName": "window_start",
            "desc": true
          }
        ]
      }
    }
  ]
}
