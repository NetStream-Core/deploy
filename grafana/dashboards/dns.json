    {
      "id": 5,
      "type": "timeseries",
      "title": "Queries per minute by type",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "netstream-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 4,
        "w": 12,
        "h": 8
