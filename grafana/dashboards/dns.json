          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(ts) AS time, max(unique_subdomains) AS max_unique_subdomains FROM dns_queries WHERE $__timeFilter(ts) AND host_id IN (${host:singlequote}) GROUP BY time ORDER BY time",
