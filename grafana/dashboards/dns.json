          "rawSql": "SELECT $__timeInterval(ts) AS time, avg(entropy) AS avg, quantile(0.95)(entropy) AS p95 FROM dns_queries WHERE $__timeFilter(ts) AND host_id IN (${host:singlequote}) GROUP BY time ORDER BY time",
