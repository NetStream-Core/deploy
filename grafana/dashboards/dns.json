          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(ts) AS time, quantile(0.5)(qname_length) AS p50, quantile(0.95)(qname_length) AS p95, max(qname_length) AS max FROM dns_queries WHERE $__timeFilter(ts) AND host_id IN (${host:singlequote}) GROUP BY time ORDER BY time",
          "pluginVersion": "4.21.3"
