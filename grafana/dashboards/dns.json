    {
      "id": 9,
      "type": "table",
      "title": "Suspicious queries",
      "description": "",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "netstream-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 14,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "netstream-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT ts AS time, toString(src_ip) AS client, qtype, qname, qname_length AS length, round(entropy, 2) AS entropy, unique_subdomains FROM dns_queries WHERE $__timeFilter(ts) AND host_id IN (${host:singlequote}) AND entropy > 3.5 AND qname_length > 30 ORDER BY ts DESC LIMIT 20",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
    {
      "id": 10,
      "type": "table",
      "title": "Domains by unique names",
      "description": "Домен второго уровня определяется как две последние метки.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "netstream-clickhouse"
      },
      "gridPos": {
        "x": 14,
        "y": 20,
        "w": 10,
        "h": 10
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "netstream-clickhouse"
          },
          "editorType": "sql",
          "format": 1,
          "queryType": "table",
          "rawSql": "SELECT registered AS domain, count() AS queries, uniq(qname) AS names, round(avg(entropy), 2) AS avg_entropy FROM (SELECT arrayStringConcat(arrayReverse(arraySlice(arrayReverse(splitByChar('.', qname)), 1, 2)), '.') AS registered, qname, entropy FROM dns_queries WHERE $__timeFilter(ts) AND host_id IN (${host:singlequote})) GROUP BY registered ORDER BY names DESC LIMIT 10",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {},
        "overrides": []
      },
      "options": {
        "showHeader": true,
        "cellHeight": "sm"
      }
    },
