      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "netstream-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(ts) AS time, qtype, count() AS queries FROM dns_queries WHERE $__timeFilter(ts) AND host_id IN (${host:singlequote}) GROUP BY time, qtype ORDER BY time",
          "pluginVersion": "4.21.3"
