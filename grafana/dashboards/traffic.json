            "uid": "netstream-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT $__timeInterval(minute) AS time, sum(tcp_syn) AS syn, sum(tcp_synack) AS synack, sum(tcp_rst) AS rst, sum(tcp_fin) AS fin FROM flows_1m WHERE $__timeFilter(minute) AND host_id IN (${host:singlequote}) GROUP BY time ORDER BY time",
          "pluginVersion": "4.21.3"
