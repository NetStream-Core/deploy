    {
      "id": 8,
      "type": "timeseries",
      "title": "TCP handshakes per minute",
      "description": "SYN-flood виден как всплеск syn при почти нулевом synack.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "netstream-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 12,
