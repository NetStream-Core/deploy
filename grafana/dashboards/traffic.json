    {
      "id": 10,
      "type": "timeseries",
      "title": "Distinct destination ports per source (port scan)",
      "description": "Максимум различных портов назначения, опрошенных одним источником за минуту. Всплеск характерен для сканирования портов.",
      "datasource": {
        "type": "grafana-clickhouse-datasource",
        "uid": "netstream-clickhouse"
      },
      "gridPos": {
        "x": 0,
        "y": 20,
        "w": 12,
        "h": 8
      },
      "targets": [
        {
          "refId": "A",
          "datasource": {
            "type": "grafana-clickhouse-datasource",
            "uid": "netstream-clickhouse"
          },
          "editorType": "sql",
          "format": 0,
          "queryType": "timeseries",
          "rawSql": "SELECT time, max(ports) AS max_ports_from_one_source FROM (SELECT toStartOfInterval(toDateTime(ts), INTERVAL 1 minute) AS time, src_ip, uniq(dst_port) AS ports FROM flows WHERE $__timeFilter(ts) AND host_id IN (${host:singlequote}) AND transport = 'tcp' AND direction = 'receive' GROUP BY time, src_ip) GROUP BY time ORDER BY time",
          "pluginVersion": "4.21.3"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "unit": "short",
          "custom": {
            "drawStyle": "bars",
            "lineWidth": 1,
            "fillOpacity": 80,
            "showPoints": "never",
            "stacking": {
              "mode": "normal",
              "group": "A"
            }
          }
        },
        "overrides": []
      },
      "options": {
        "legend": {
          "displayMode": "list",
          "placement": "bottom",
          "showLegend": true
        },
        "tooltip": {
          "mode": "multi",
          "sort": "desc"
        }
      },
      "interval": "1m"
    },
