          "rawSql": "SELECT toString(src_ip) AS source, uniq(dst_port) AS ports, uniq(dst_ip) AS targets, sum(tcp_syn) AS syn, sum(tcp_rst) AS rst FROM flows WHERE $__timeFilter(ts) AND host_id IN (${host:singlequote}) AND transport = 'tcp' AND direction = 'receive' GROUP BY src_ip ORDER BY ports DESC LIMIT 10",
