          "rawSql": "SELECT $__timeInterval(minute) AS time, sumIf(tcp_syn, direction = 'receive') / greatest(sumIf(tcp_synack, direction = 'transmit'), 1) AS ratio FROM flows_1m WHERE $__timeFilter(minute) AND host_id IN (${host:singlequote}) GROUP BY time ORDER BY time",
